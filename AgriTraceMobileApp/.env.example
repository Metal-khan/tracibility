# Copy this file to .env and adjust for your setup. Expo automatically
# exposes any variable prefixed with EXPO_PUBLIC_ to the app at build/start
# time — no extra config needed.

# Base URL of the Laravel API, including /api.
#
# - iOS Simulator (macOS):        http://localhost:8000/api
# - Android Emulator:             http://10.0.2.2:8000/api   (used automatically if unset)
# - Physical phone via Expo Go:   http://<your-machine-LAN-IP>:8000/api
#     Find your LAN IP with `ipconfig getifaddr en0` (macOS) or `ipconfig` (Windows),
#     and make sure the phone is on the same Wi-Fi network. Start the backend with
#     `php artisan serve --host=0.0.0.0` so it accepts connections from other devices.
# - Staging/production backend:   https://api.your-domain.com/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api
