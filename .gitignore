# Root .gitignore for the workspace

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Editor/IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Composer / PHP
vendor/
composer.lock
.env
.env.*
!.env.example
!**/.env.example

# Laravel / backend specific
agritrace-backend/vendor/
agritrace-backend/node_modules/
agritrace-backend/.env
agritrace-backend/public/storage
# storage/ itself is tracked (see the per-folder .gitignore files inside it) —
# Laravel needs storage/framework/{cache,sessions,views}, storage/framework/testing,
# and storage/logs to exist at runtime, and doesn't create them automatically.
# Without them, a fresh clone fails with "Please provide a valid cache path."
# the moment anything tries to render a view (including Laravel's own error page).

# Mobile / React Native / Expo specific
AgriTraceMobileApp/node_modules/
AgriTraceMobileApp/android/
AgriTraceMobileApp/ios/
AgriTraceMobileApp/.expo/
AgriTraceMobileApp/.expo-shared/
AgriTraceMobileApp/.env
AgriTraceMobileApp/build/
AgriTraceMobileApp/dist/

# Logs
*.log
logs/
!agritrace-backend/storage/logs/
!agritrace-backend/storage/logs/.gitignore

# Build outputs
dist/
build/
