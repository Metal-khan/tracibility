}

### Login Admin
POST http://127.0.0.1:8000/api/login
Content-Type: application/json

{
  "email": "admin@agritrace.com",
  "password": "password"
}

### Moderate Review: Approve
# Get Review ID from phpMyAdmin or previous Submit Review response
POST http://127.0.0.1:8000/api/reviews/REVIEW_ID_HERE/moderate
Content-Type: application/json
Authorization: Bearer YOUR_ADMIN_AUTH_TOKEN_HERE
Accept: application/json

{
  "action": "approve"
}

### Moderate Review: Reject
# Get Review ID from phpMyAdmin or previous Submit Review response
POST http://127.0.0.1:8000/api/reviews/REVIEW_ID_HERE/moderate
Content-Type: application/json
Authorization: Bearer YOUR_ADMIN_AUTH_TOKEN_HERE
Accept: application/json

{
  "action": "reject"
}

### Moderate Review: Hide
# Get Review ID from phpMyAdmin or previous Submit Review response
POST http://127.0.0.1:8000/api/reviews/REVIEW_ID_HERE/moderate
Content-Type: application/json
Authorization: Bearer YOUR_ADMIN_AUTH_TOKEN_HERE
Accept: application/json

{
  "action": "hide"
}

