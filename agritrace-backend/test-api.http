### Create Product (Farmer only) - Use this to get a new Product ID
POST http://127.0.0.1:8000/api/products
Content-Type: multipart/form-data; boundary=agritrace-product-boundary
Authorization: Bearer 4|zXZpcKck8N3v2ON6oG5uVQTqrkN8SGtNDLG9a5tg8542d373
Accept: application/json

--agritrace-product-boundary
Content-Disposition: form-data; name="crop_type"

Test Product for Reviews
--agritrace-product-boundary
Content-Disposition: form-data; name="quantity"

100
--agritrace-product-boundary
Content-Disposition: form-data; name="unit"

kg
--agritrace-product-boundary
Content-Disposition: form-data; name="harvest_date"

2025-07-17
--agritrace-product-boundary
Content-Disposition: form-data; name="description"

Product to receive reviews.
--agritrace-product-boundary
Content-Disposition: form-data; name="origin_location_lat"

34.0151
--agritrace-product-boundary
Content-Disposition: form-data; name="origin_location_lon"

71.5249
--agritrace-product-boundary
Content-Disposition: form-data; name="origin_location_address"

Peshawar, Pakistan
--agritrace-product-boundary
Content-Disposition: form-data; name="photos[]"; filename="review_test_photo.jpg"
Content-Type: image/jpeg

< C:\Users\mujtb\Desktop\Desktop\image\tomato.png
--agritrace-product-boundary--

