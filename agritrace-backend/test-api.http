### Submit Review 1 (Buyer)
# Use the ID of a product to review (e.g., the one created above)
POST http://127.0.0.1:8000/api/products/16/reviews
Content-Type: application/json
Authorization: Bearer 6|pSMPzckGn8tixjPuS996u1UdOfoXH325gncKPVxfa664fb71
Accept: application/json

{
  "rating": 5,
  "comment": "Excellent product quality! Highly recommended."
}

### Submit Review 2 (Buyer)
# Use the same or different Product ID
POST http://127.0.0.1:8000/api/products/16/reviews
Content-Type: application/json
Authorization: Bearer 6|pSMPzckGn8tixjPuS996u1UdOfoXH325gncKPVxfa664fb71
Accept: application/json

{
  "rating": 3,
  "comment": "Good, but packaging could be better."
}

### Submit Review 3 (Buyer)
# Use the same or different Product ID
POST http://127.0.0.1:8000/api/products/16/reviews
Content-Type: application/json
Authorization: Bearer 6|pSMPzckGn8tixjPuS996u1UdOfoXH325gncKPVxfa664fb71
